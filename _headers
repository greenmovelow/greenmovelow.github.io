# Netlify custom headers

# Site-wide Content-Security-Policy, sent by the origin. It matches the
# site-wide policy served before this rule existed (added outside this repo,
# at the edge), except that script-src no longer
# allows 'unsafe-inline': all executable JavaScript lives in same-origin .js
# files (inline on* handlers became data-action, see /assets/js/actions.js).
# JSON-LD <script type="application/ld+json"> blocks are data and stay inline.
# scripts/audit_csp.py fails if inline JS or handlers come back.
# Keep this rule first: more specific rules below (e.g. the records status
# page) set their own, stricter policy.
/*
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; img-src 'self' data: https:; font-src 'self' data: https:; style-src 'self' 'unsafe-inline' https:; script-src 'self' https://static.cloudflareinsights.com https://www.googletagmanager.com https://www.google-analytics.com https://cdn.jsdelivr.net https://gc.zgo.at; connect-src 'self' https://cloudflareinsights.com https://*.google-analytics.com https://restoring-democracy.goatcounter.com/count; frame-src https://substack.com https://*.substack.com; upgrade-insecure-requests;

# Text companions have an HTML canonical URL and do not opt into AI training.
/index.md
  Content-Type: text/markdown; charset=utf-8
  Link: <https://restoring-democracy.org/>; rel="canonical"
  Content-Signal: ai-train=no, search=yes, ai-input=yes
/about/index.md
  Content-Type: text/markdown; charset=utf-8
  Link: <https://restoring-democracy.org/about/>; rel="canonical"
  Content-Signal: ai-train=no, search=yes, ai-input=yes
/corrections/index.md
  Content-Type: text/markdown; charset=utf-8
  Link: <https://restoring-democracy.org/corrections/>; rel="canonical"
  Content-Signal: ai-train=no, search=yes, ai-input=yes
/analytics/index.md
  Content-Type: text/markdown; charset=utf-8
  Link: <https://restoring-democracy.org/analytics/>; rel="canonical"
  Content-Signal: ai-train=no, search=yes, ai-input=yes
/team/index.md
  Content-Type: text/markdown; charset=utf-8
  Link: <https://restoring-democracy.org/team/>; rel="canonical"
  Content-Signal: ai-train=no, search=yes, ai-input=yes
/ai-use/index.md
  Content-Type: text/markdown; charset=utf-8
  Link: <https://restoring-democracy.org/ai-use/>; rel="canonical"
  Content-Signal: ai-train=no, search=yes, ai-input=yes

# Cache the feed JSON at CDN/browser for 15 min, serve stale while revalidating.
/latest-investigations.json
  Cache-Control: public, max-age=900, stale-while-revalidate=3600

/resources/reference/records/status/
  X-Robots-Tag: noindex, nofollow, noarchive, nosnippet
  Cache-Control: no-store, max-age=0
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Content-Security-Policy: default-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; img-src 'none'; script-src 'none'; style-src 'self'; font-src 'self'; connect-src 'none'; media-src 'none'; object-src 'none'; manifest-src 'none'; worker-src 'none'

/resources/reference/records/status/index.html
  X-Robots-Tag: noindex, nofollow, noarchive, nosnippet
  Cache-Control: no-store, max-age=0
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Content-Security-Policy: default-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; img-src 'none'; script-src 'none'; style-src 'self'; font-src 'self'; connect-src 'none'; media-src 'none'; object-src 'none'; manifest-src 'none'; worker-src 'none'

# Editorial handoff prototypes are source material, not published pages.
/_handoff/*
  X-Robots-Tag: noindex, nofollow, noarchive
